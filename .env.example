# Copia este archivo como .env (cp .env.example .env) y llénalo. .env NUNCA se sube a git.

# Llave de Pinata (JWT). Pinata la muestra UNA sola vez al crearla.
PINATA_JWT=

# Grupo de Pinata donde quedan los PDF (opcional). Si lo dejas vacío,
# `npm run emitir` crea o reutiliza el grupo "certificados-uanl-2026".
PINATA_GROUP=certificados-uanl-2026

# Gateway dedicado, el que sale en Pinata → Gateways (sin https://), p. ej. ejemplo-123.mypinata.cloud
PINATA_GATEWAY=

{
  "name": "certificados-uanl-contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "RegistroCertificados: certificados académicos con reclamo por link en Asset Hub (PolkaVM).",
  "scripts": {
    "build": "resolc --bin -O3 --output-dir out --overwrite contracts/RegistroCertificados.sol && npm run build:evm",
    "build:evm": "solc --abi --bin --optimize -o out-evm --overwrite contracts/RegistroCertificados.sol",
    "test": "node test/registro.test.mjs",
    "simulate": "node scripts/deploy.mjs --simulate",
    "deploy": "node scripts/deploy.mjs",
    "build:test": "resolc --bin -O3 --output-dir out-test --overwrite test/pvm/ProbarFirma.sol",
    "probar-pvm": "npm run build:test && node scripts/probar-pvm.mjs"
  },
  "dependencies": {
    "@polkadot-labs/hdkd": "^0.0.29",
    "@polkadot-labs/hdkd-helpers": "^0.0.31",
    "polkadot-api": "~2.2.1",
    "viem": "^2.56.8"
  },
  "devDependencies": {
    "@ethereumjs/block": "^10.1.3",
    "@ethereumjs/evm": "^10.1.3",
    "@ethereumjs/util": "^10.1.3",
    "@ethereumjs/vm": "^10.1.3"
  }
}

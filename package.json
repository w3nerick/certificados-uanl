{
  "name": "certificados-uanl",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Certificados en Cadena: certificados de la UANL en Asset Hub, con PDF en IPFS y reclamo por link. App .dot para Polkadot App y web de verificación.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "manifest": "node scripts/manifest.mjs",
    "check": "node scripts/check.mjs",
    "check-deploy": "node scripts/check-deploy.mjs",
    "test": "node --import tsx --test --test-force-exit test/*.test.ts",
    "emitir": "node --import tsx tools/emitir.ts",
    "relayer": "node --import tsx tools/relayer.ts",
    "admin": "node --import tsx tools/admin.ts"
  },
  "dependencies": {
    "@parity/product-sdk-host": "0.19.1",
    "@parity/product-sdk-signer": "0.14.4",
    "@polkadot-labs/hdkd": "0.0.29",
    "@polkadot-labs/hdkd-helpers": "0.0.31",
    "@scure/sr25519": "2.4.0",
    "polkadot-api": "~2.2.1",
    "viem": "2.56.8"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/bitter": "^5.3.0",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "@types/node": "^22.20.5",
    "multiformats": "13.4.2",
    "pdfjs-dist": "^5.4.0",
    "tsx": "4.20.6",
    "typescript": "~5.9.3",
    "uqr": "0.1.3",
    "vite": "^7.1.0"
  }
}
